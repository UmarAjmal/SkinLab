generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // Admin, Manager, Doctor, Cashier, etc.
  description String?
  is_system   Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
}

model RolePermission {
  id         String   @id @default(uuid())
  role_id    String
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  module     String   // dashboard, patients, services, staff, purchases, pos, sales, reports, settings, users
  can_read   Boolean  @default(false)
  can_write  Boolean  @default(false)
  can_delete Boolean  @default(false)

  @@unique([role_id, module])
}

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  employees Employee[]
}

model Employee {
  id            String      @id @default(uuid())
  name          String
  is_doctor     Boolean     @default(false)
  department_id String?
  department    Department? @relation(fields: [department_id], references: [id])
  users         User[]
  sales         Sale[]      @relation("DoctorSales")
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  is_active   Boolean   @default(true)
  role_id     String
  role        Role      @relation(fields: [role_id], references: [id])
  employee_id String?
  employee    Employee? @relation(fields: [employee_id], references: [id])
  sales       Sale[]    @relation("UserSales")
}

model Customer {
  id              String  @id @default(uuid())
  medical_id      String  @unique // Format: 0001-MM-YYYY
  name            String
  phone           String?
  email           String?
  address         String?
  current_balance Float   @default(0)
  advance_balance Float   @default(0)
  sales           Sale[]
  payments        Payment[]

  @@index([phone])
  @@index([name])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id             String         @id @default(uuid())
  name           String
  sku            String?        @unique
  barcode        String?        @unique
  category_id    String
  category       Category       @relation(fields: [category_id], references: [id])
  cost_price     Float
  selling_price  Float
  tax_class      String?
  stock_quantity Int            @default(0)
  deal_items     DealItem[]
  sale_items     SaleItem[]
  purchase_items PurchaseItem[]
}

model Deal {
  id          String     @id @default(uuid())
  name        String
  total_price Float
  items       DealItem[]
}

model DealItem {
  id               String  @id @default(uuid())
  deal_id          String
  deal             Deal    @relation(fields: [deal_id], references: [id])
  product_id       String
  product          Product @relation(fields: [product_id], references: [id])
  quantity         Int
  sessions_allowed Int     @default(1)
}

model Sale {
  id              String     @id @default(uuid())
  invoice_number  String     @unique
  customer_id     String
  customer        Customer   @relation(fields: [customer_id], references: [id])
  user_id         String
  user            User       @relation("UserSales", fields: [user_id], references: [id])
  doctor_id       String?
  doctor          Employee?  @relation("DoctorSales", fields: [doctor_id], references: [id])
  date            DateTime   @default(now())
  subtotal        Float
  discount_amount Float      @default(0)
  grand_total     Float
  paid_amount     Float      @default(0)
  payment_status  String     // PAID, PARTIAL, DUE
  payment_method  String?    // Cash, Card, Credit
  session_remarks String?
  items           SaleItem[]
  returns         ReturnSale[]
  payments        Payment[]

  @@index([date])
  @@index([payment_status])
}

model SaleItem {
  id                String  @id @default(uuid())
  sale_id           String
  sale              Sale    @relation(fields: [sale_id], references: [id])
  product_id        String
  product           Product @relation(fields: [product_id], references: [id])
  quantity          Int
  unit_price        Float
  sessions_allowed  Int     @default(1)
  sessions_consumed Int     @default(0)
  item_group_name   String?
  total_price       Float
  returns           SaleProductReturn[]
}

model Supplier {
  id             String     @id @default(uuid())
  name           String
  contact_person String?
  phone          String?
  address        String?
  tax_number     String?
  balance        Float      @default(0)
  purchases      Purchase[]
}

model Purchase {
  id               String         @id @default(uuid())
  invoice_number   String         @unique
  supplier_id      String
  supplier         Supplier       @relation(fields: [supplier_id], references: [id])
  date             DateTime       @default(now())
  subtotal         Float
  delivery_charges Float          @default(0)
  tax              Float          @default(0)
  grand_total      Float
  status           String         @default("RECEIVED") // RECEIVED, PENDING
  items            PurchaseItem[]
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchase_id String
  purchase    Purchase @relation(fields: [purchase_id], references: [id])
  product_id  String
  product     Product  @relation(fields: [product_id], references: [id])
  quantity    Int
  unit_cost   Float
  total_cost  Float
}

model CompanySetting {
  id          String  @id @default(uuid())
  name        String
  phone       String?
  logo        String?
  address     String?
  tax_number  String?
  footer_note String?
}

model ReturnSale {
  id            String              @id @default(uuid())
  sale_id       String
  sale          Sale                @relation(fields: [sale_id], references: [id])
  date          DateTime            @default(now())
  reason        String?
  refund_amount Float
  processed_by  String              // user_id of staff who processed
  items         SaleProductReturn[]
}

model SaleProductReturn {
  id                String      @id @default(uuid())
  return_sale_id    String
  return_sale       ReturnSale  @relation(fields: [return_sale_id], references: [id], onDelete: Cascade)
  sale_item_id      String
  sale_item         SaleItem    @relation(fields: [sale_item_id], references: [id])
  quantity_returned Int
  refund_amount     Float
}

model Payment {
  id             String    @id @default(uuid())
  sale_id        String?
  sale           Sale?     @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  customer_id    String
  customer       Customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  amount         Float
  payment_method String    // Cash, Card, Credit, etc.
  payment_date   DateTime  @default(now())
  received_by    String?   // User / Staff ID or Name
  notes          String?
  created_at     DateTime  @default(now())

  @@index([payment_date])
  @@index([customer_id])
  @@index([sale_id])
}
