generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // Admin, Manager, Doctor, Cashier, etc.
  description String?
  is_system   Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
}

model RolePermission {
  id         String   @id @default(uuid())
  role_id    String
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  module     String   // dashboard, patients, services, staff, purchases, pos, sales, reports, settings, users, expenses
  can_read   Boolean  @default(false)
  can_write  Boolean  @default(false)
  can_delete Boolean  @default(false)

  @@unique([role_id, module])
}

model Department {
  id         String          @id @default(uuid())
  name       String
  company_id String?
  company    CompanySetting? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employees  Employee[]

  @@index([company_id])
}

model Employee {
  id            String          @id @default(uuid())
  name          String
  is_doctor     Boolean         @default(false)
  department_id String?
  department    Department?     @relation(fields: [department_id], references: [id])
  company_id    String?
  company       CompanySetting? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users         User[]
  sales         Sale[]          @relation("DoctorSales")

  @@index([company_id])
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  full_name      String?
  phone          String?
  is_active      Boolean         @default(true)
  is_first_login Boolean         @default(true)
  role_id        String
  role           Role            @relation(fields: [role_id], references: [id])
  employee_id    String?
  employee       Employee?       @relation(fields: [employee_id], references: [id])
  company_id     String?
  company        CompanySetting? @relation(fields: [company_id], references: [id])
  sales          Sale[]          @relation("UserSales")
  expenses       Expense[]       @relation("UserExpenses")
  notifications  Notification[]  @relation("UserNotifications")

  @@index([company_id])
}

model Customer {
  id              String          @id @default(uuid())
  medical_id      String          // Format: 0001-MM-YYYY
  name            String
  phone           String?
  email           String?
  address         String?
  current_balance Float           @default(0)
  advance_balance Float           @default(0)
  company_id      String?
  company         CompanySetting? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  sales           Sale[]
  payments        Payment[]

  @@index([company_id])
  @@index([phone])
  @@index([name])
}

model Category {
  id         String          @id @default(uuid())
  name       String
  company_id String?
  company    CompanySetting? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([company_id])
}

model Product {
  id             String          @id @default(uuid())
  name           String
  sku            String?
  barcode        String?
  category_id    String
  category       Category        @relation(fields: [category_id], references: [id])
  company_id     String?
  company        CompanySetting? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  cost_price     Float
  selling_price  Float
  tax_class      String?
  stock_quantity Int             @default(0)
  deal_items     DealItem[]
  sale_items     SaleItem[]
  purchase_items PurchaseItem[]

  @@index([company_id])
  @@index([category_id])
}

model Deal {
  id          String          @id @default(uuid())
  name        String
  total_price Float
  company_id  String?
  company     CompanySetting? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  items       DealItem[]

  @@index([company_id])
}

model DealItem {
  id               String  @id @default(uuid())
  deal_id          String
  deal             Deal    @relation(fields: [deal_id], references: [id])
  product_id       String
  product          Product @relation(fields: [product_id], references: [id])
  quantity         Int
  sessions_allowed Int     @default(1)
}

model Sale {
  id              String          @id @default(uuid())
  invoice_number  String
  customer_id     String
  customer        Customer        @relation(fields: [customer_id], references: [id])
  user_id         String
  user            User            @relation("UserSales", fields: [user_id], references: [id])
  doctor_id       String?
  doctor          Employee?       @relation("DoctorSales", fields: [doctor_id], references: [id])
  company_id      String?
  company         CompanySetting? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  date            DateTime        @default(now())
  subtotal        Float
  discount_amount Float           @default(0)
  grand_total     Float
  paid_amount     Float           @default(0)
  payment_status  String          // PAID, PARTIAL, DUE
  payment_method  String?         // Cash, Card, Credit
  session_remarks String?
  items           SaleItem[]
  returns         ReturnSale[]
  payments        Payment[]

  @@index([company_id])
  @@index([date])
  @@index([payment_status])
}

model SaleItem {
  id                String              @id @default(uuid())
  sale_id           String
  sale              Sale                @relation(fields: [sale_id], references: [id])
  product_id        String
  product           Product             @relation(fields: [product_id], references: [id])
  quantity          Int
  unit_price        Float
  sessions_allowed  Int                 @default(1)
  sessions_consumed Int                 @default(0)
  item_group_name   String?
  total_price       Float
  returns           SaleProductReturn[]
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contact_person String?
  phone          String?
  address        String?
  tax_number     String?
  balance        Float           @default(0)
  company_id     String?
  company        CompanySetting? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  purchases      Purchase[]

  @@index([company_id])
}

model Purchase {
  id               String          @id @default(uuid())
  invoice_number   String
  supplier_id      String
  supplier         Supplier        @relation(fields: [supplier_id], references: [id])
  company_id       String?
  company          CompanySetting? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  date             DateTime        @default(now())
  subtotal         Float
  delivery_charges Float           @default(0)
  tax              Float           @default(0)
  grand_total      Float
  status           String          @default("RECEIVED") // RECEIVED, PENDING
  items            PurchaseItem[]

  @@index([company_id])
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchase_id String
  purchase    Purchase @relation(fields: [purchase_id], references: [id])
  product_id  String
  product     Product  @relation(fields: [product_id], references: [id])
  quantity    Int
  unit_cost   Float
  total_cost  Float
}

model CompanySetting {
  id                 String            @id @default(uuid())
  name               String
  phone              String?
  logo               String?
  address            String?
  tax_number         String?
  footer_note        String?
  theme_config       String?
  plan               String?           @default("Monthly Subscription")
  plan_price         Float?            @default(3000)
  owner_id           String?
  owner_name         String?
  owner_phone        String?
  users              User[]
  departments        Department[]
  employees          Employee[]
  customers          Customer[]
  categories         Category[]
  products           Product[]
  deals              Deal[]
  sales              Sale[]
  payments           Payment[]
  suppliers          Supplier[]
  purchases          Purchase[]
  expense_categories ExpenseCategory[]
  expenses           Expense[]
  notifications      Notification[]
  created_at         DateTime          @default(now())
  updated_at         DateTime          @default(now()) @updatedAt
}

model ReturnSale {
  id            String              @id @default(uuid())
  sale_id       String
  sale          Sale                @relation(fields: [sale_id], references: [id])
  date          DateTime            @default(now())
  reason        String?
  refund_amount Float
  processed_by  String              // user_id of staff who processed
  items         SaleProductReturn[]
}

model SaleProductReturn {
  id                String     @id @default(uuid())
  return_sale_id    String
  return_sale       ReturnSale @relation(fields: [return_sale_id], references: [id], onDelete: Cascade)
  sale_item_id      String
  sale_item         SaleItem   @relation(fields: [sale_item_id], references: [id])
  quantity_returned Int
  refund_amount     Float
}

model Payment {
  id             String          @id @default(uuid())
  sale_id        String?
  sale           Sale?           @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  customer_id    String
  customer       Customer        @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  company_id     String?
  company        CompanySetting? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  amount         Float
  payment_method String          // Cash, Card, Credit, etc.
  payment_date   DateTime        @default(now())
  received_by    String?         // User / Staff ID or Name
  notes          String?
  created_at     DateTime        @default(now())

  @@index([company_id])
  @@index([payment_date])
  @@index([customer_id])
  @@index([sale_id])
}

model ExpenseCategory {
  id          String          @id @default(uuid())
  name        String
  description String?
  company_id  String?
  company     CompanySetting? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @default(now()) @updatedAt
  expenses    Expense[]

  @@index([company_id])
}

model Expense {
  id             String          @id @default(uuid())
  title          String
  amount         Float
  category_id    String
  category       ExpenseCategory @relation(fields: [category_id], references: [id], onDelete: Restrict)
  company_id     String?
  company        CompanySetting? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  date           DateTime        @default(now())
  payment_method String          @default("Cash") // Cash, Bank Transfer, Card, Online, Cheque, Other
  payee          String?         // Vendor, employee, landlord, utility company, etc.
  notes          String?
  reference_no   String?         // Bill number, receipt voucher no, cheque no
  receipt_url    String?
  created_by_id  String?
  created_by     User?           @relation("UserExpenses", fields: [created_by_id], references: [id])
  created_at     DateTime        @default(now())
  updated_at     DateTime        @default(now()) @updatedAt

  @@index([company_id])
  @@index([date])
  @@index([category_id])
}

model Notification {
  id          String          @id @default(uuid())
  title       String
  message     String
  type        String          // SALE_CREATED, SALE_UPDATED, EXPENSE_CREATED, REFUND_PROCESSED, OVERDUE_DUES, PAYMENT_RECEIVED, SYSTEM_ALERT
  severity    String          @default("INFO") // INFO, WARNING, URGENT, SUCCESS
  link_url    String?         // URL to navigate upon clicking
  is_read     Boolean         @default(false)
  
  target_role String?         // "Admin", "Manager", "Doctor", "Cashier" (null = all staff)
  user_id     String?         // targeted specific user ID
  user        User?           @relation("UserNotifications", fields: [user_id], references: [id], onDelete: Cascade)
  company_id  String?
  company     CompanySetting? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  
  metadata    Json?           // Optional structured metadata
  created_at  DateTime        @default(now())

  @@index([company_id])
  @@index([created_at])
  @@index([is_read])
  @@index([target_role])
  @@index([user_id])
}
